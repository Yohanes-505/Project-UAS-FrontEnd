PORT=3000

# Koneksi PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE?schema=public
# Database-nya harus sudah dibuat dulu (mis. lewat pgAdmin atau: createdb lamak_bana).
# Kalau pakai Supabase/Neon, tempel connection string dari dashboard mereka di sini.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lamak_bana?schema=public"

# Zona waktu untuk laporan per hari/bulan (opsional, default Asia/Jakarta).
APP_TIMEZONE=Asia/Jakarta
